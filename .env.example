# Flask Configuration
FLASK_APP=run.py
FLASK_DEBUG=1
FLASK_CONFIG=development  # Use 'production' in deployment

# Application Secrets (Required in production)
SECRET_KEY=replace-with-a-secure-random-secret-key

# Database Configuration (Defaults to SQLite instance/lost_and_found.db if unset)
# DATABASE_URL=sqlite:///instance/lost_and_found.db

# Gunicorn Production Tuning (Optional)
# PORT=10000
# WEB_CONCURRENCY=2

